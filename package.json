{
  "name": "opspilot",
  "version": "0.1.0-spec",
  "private": true,
  "description": "Open-source, deployment-aware AI operations platform",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint packages/*/src/**/*.ts",
    "pretest": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run packages/domain packages/contracts packages/security packages/deployment-providers packages/application",
    "test:db": "vitest run packages/database",
    "test:security": "vitest run packages/deployment-providers/tests/hardened-build-runner.spec.ts packages/security/tests/secret-redactor.spec.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/eslint-parser": "^7.29.13",
    "@babel/preset-typescript": "^7.29.7",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "pg": "^8.23.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
