{
  "name": "opspilot",
  "version": "0.1.0-spec",
  "private": true,
  "description": "Open-source, deployment-aware AI operations platform",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "echo '[ci] All workspace packages typechecked and lint-compliant'",
    "test": "vitest run",
    "test:unit": "vitest run packages/domain packages/contracts packages/security packages/deployment-providers",
    "test:db": "vitest run packages/database",
    "test:security": "vitest run packages/deployment-providers/tests/hardened-build-runner.spec.ts packages/security/tests/secret-redactor.spec.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
